# Encrypts each user's Garmin password at rest. Generate one with
# `openssl rand -hex 32`; changing it after credentials are saved locks
# everyone out of their stored Garmin login.
CREDENTIALS_ENCRYPTION_KEY=

# Get these by running `supabase status` (local dev) or from your hosted
# project's Settings > API page.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Consumed by the Vite frontend (must be prefixed VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://127.0.0.1:8788

# Port the local sync backend listens on
PORT=8788

# Carto basemap API key. Without it Carto stamps "API KEY REQUIRED" across the
# map tiles once the anonymous request allowance is used up.
VITE_CARTO_API_KEY=

# Wahoo Cloud API, for power-meter data the watch never sees. Register an app
# at developers.wahooligan.com; the redirect URI only has to match what you
# registered, it is never actually served. Leave blank to skip the Wahoo step.
# After filling these in, run `npm run wahoo:auth -- <user-id>` in backend/ once.
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=
WAHOO_REDIRECT_URI=https://localhost:8788/wahoo/callback
